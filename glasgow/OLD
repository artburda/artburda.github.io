<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arthur Burda – Glasgow & Luss</title>

    <link rel="icon" href="/favicon.png?v=3" type="image/png">
    <link rel="shortcut icon" href="/favicon.png?v=3" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png?v=3">

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: #ffffff;
            color: #111111;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        }

        .cover {
            padding: 90px 24px 64px;
            text-align: center;
        }

        h1 {
            margin: 0;
            font-size: 2.8rem;
            font-weight: 300;
            letter-spacing: 0.01em;
        }

        .subtitle {
            color: #666666;
            margin-top: 12px;
            font-size: 1rem;
            font-weight: 300;
        }

        .nav-buttons {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            gap: 12px;
        }

        .nav-buttons a {
            text-decoration: none;
            color: #111111;
            border: 1px solid #e5e5e5;
            border-radius: 999px;
            padding: 10px 20px;
            font-size: 0.8rem;
            font-weight: 400;
            transition: all 0.2s ease;
        }

        .nav-buttons a:hover {
            background: #111111;
            color: #ffffff;
        }

        .gallery {
            max-width: 1500px;
            margin: 0 auto;
            padding: 0 60px 80px;
            position: relative;
        }

        .gallery img {
            position: absolute;
            height: auto;
            display: block;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.35s ease;
        }

        .gallery img.loaded {
            opacity: 1;
        }

        .gallery img.loaded:hover {
            opacity: 0.9;
        }

        .lightbox {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.97);
            z-index: 9999;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 32px 20px;
        }

        .lightbox.active {
            display: flex;
        }

        .lightbox img {
            max-width: 92vw;
            max-height: 82vh;
            width: auto;
            height: auto;
        }

        .prev,
        .next {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: none;
            color: #cfcfcf;
            font-size: 2.2rem;
            cursor: pointer;
            z-index: 10000;
        }

        .prev:hover,
        .next:hover {
            color: #777777;
        }

        .prev {
            left: 0;
        }

        .next {
            right: 0;
        }

        .close {
            position: fixed;
            top: 20px;
            right: 30px;
            background: none;
            border: none;
            font-size: 2rem;
            color: #111111;
            cursor: pointer;
            padding: 16px;
        }

        footer {
            text-align: center;
            padding: 64px 24px 48px;
            color: #666666;
            font-size: 0.86rem;
            line-height: 1.6;
        }

        .print-note {
            margin: 0 0 28px;
            color: #555555;
            font-size: 0.84rem;
            font-weight: 300;
        }

        .copyright {
            color: #777777;
            font-size: 0.78rem;
        }

        .rights-notice {
            display: block;
            max-width: 620px;
            margin: 18px auto 0;
            color: #aaaaaa;
            font-size: 0.68rem;
            line-height: 1.5;
        }

        @media (max-width: 700px) {
            .cover {
                padding: 56px 16px 40px;
            }

            h1 {
                font-size: 2.2rem;
            }

            .subtitle {
                font-size: 0.95rem;
            }

            .nav-buttons {
                margin-top: 28px;
                gap: 10px;
            }

            .nav-buttons a {
                padding: 9px 15px;
                font-size: 0.78rem;
            }

            .gallery {
                padding: 0 20px 40px;
            }

            .lightbox {
                padding: 24px 14px;
            }

            .lightbox img {
                max-width: 94vw;
                max-height: 78vh;
            }

            .prev,
            .next {
                top: auto;
                bottom: 22px;
                transform: none;
                font-size: 2rem;
                color: #999999;
                background: rgba(255, 255, 255, 0.75);
                padding: 8px 18px;
            }

            .prev {
                left: 70px;
            }

            .next {
                right: 70px;
            }

            .close {
                top: 10px;
                right: 14px;
            }
        }
    </style>
</head>

<body>
    <section class="cover">
        <h1>Arthur Burda</h1>
        <p class="subtitle">Glasgow &amp; Luss</p>

        <div class="nav-buttons">
            <a href="/">Zurück</a>
        </div>
    </section>

    <main class="gallery" id="gallery">
        <img src="../scotland/Scotland_01.jpg" alt="">
        <img src="../scotland/ampel_toeggel.jpg" alt="">
        <img src="../scotland/frauen.jpg" alt="">
        <img src="../scotland/Toeggel.jpg" alt="">
        <img src="../scotland/auto.jpg" alt="">
        <img src="../scotland/Scotland_22.jpg" alt="">
        <img src="../scotland/Scotland_27.jpg" alt="">
        <img src="../scotland/Scotland_35.jpg" alt="">
        <img src="../scotland/haltestelle.jpg" alt="">
        <img src="../scotland/Scotland_40.jpg" alt="">
        <img src="../scotland/Scotland_41.jpg" alt="">
        <img src="../scotland/Scotland_43.jpg" alt="">
        <img src="../scotland/Scotland_45.jpg" alt="">
        <img src="../scotland/Scotland_47.jpg" alt="">
        <img src="../scotland/Scotland_49.jpg" alt="">
        <img src="../scotland/Scotland_53.jpg" alt="">
        <img src="../scotland/Scotland_54.jpg" alt="">
        <img src="../scotland/Scotland_55.jpg" alt="">
        <img src="../scotland/Scotland_38.jpg" alt="">
        <img src="../scotland/Scotland_39.jpg" alt="">
        <img src="../scotland/Scotland_59.jpg" alt="">
        <img src="../scotland/Scotland_60.jpg" alt="">
        <img src="../scotland/Scotland_62.jpg" alt="">
        <img src="../scotland/Scotland_63.jpg" alt="">
        <img src="../scotland/Scotland_65.jpg" alt="">
        <img src="../scotland/Bruecke.jpg" alt="">
    </main>

    <div class="lightbox" id="lightbox">
        <button class="close" onclick="closeLightbox()">×</button>
        <button class="prev" onclick="prevImage()">‹</button>
        <img id="lightbox-img" src="" alt="">
        <button class="next" onclick="nextImage()">›</button>
    </div>

    <footer>
        <p class="print-note">
            Prints ausgewählter Arbeiten auf Anfrage.
        </p>

        <div class="copyright">
            © 2026 Arthur Burda · Alle Rechte vorbehalten.
        </div>

        <span class="rights-notice">
            Die Verwendung der Fotografien und Inhalte dieser Website für
            AI-Training, Machine Learning, automatisierte Datensammlung oder
            vergleichbare Zwecke ist ohne ausdrückliche Zustimmung nicht gestattet.
        </span>
    </footer>

    <script>
        const gallery = document.getElementById("gallery");
        const images = document.querySelectorAll(".gallery img");
        const lightbox = document.getElementById("lightbox");
        const lightboxImg = document.getElementById("lightbox-img");

        let currentIndex = 0;
        let touchStartX = 0;
        let touchEndX = 0;

        function getColumnCount() {
            if (window.innerWidth <= 700) return 2;
            if (window.innerWidth <= 1000) return 3;
            return 4;
        }

        function getGap() {
            if (window.innerWidth <= 700) return 8;
            return 14;
        }

        function layoutMasonry() {
            const columnCount = getColumnCount();
            const gap = getGap();

            const styles = window.getComputedStyle(gallery);
            const paddingLeft = parseFloat(styles.paddingLeft);
            const paddingRight = parseFloat(styles.paddingRight);

            const galleryWidth = gallery.clientWidth - paddingLeft - paddingRight;
            const columnWidth = (galleryWidth - gap * (columnCount - 1)) / columnCount;
            const columnHeights = new Array(columnCount).fill(0);

            images.forEach((img) => {
                img.style.width = columnWidth + "px";

                const shortestColumn = columnHeights.indexOf(Math.min(...columnHeights));
                const x = paddingLeft + shortestColumn * (columnWidth + gap);
                const y = columnHeights[shortestColumn];

                img.style.left = x + "px";
                img.style.top = y + "px";

                const ratio = img.naturalWidth > 0
                    ? img.naturalHeight / img.naturalWidth
                    : 1.5;

                columnHeights[shortestColumn] += columnWidth * ratio + gap;
            });

            gallery.style.height = Math.max(...columnHeights) + "px";
        }

        function relayoutSeveralTimes() {
            layoutMasonry();
            setTimeout(layoutMasonry, 250);
            setTimeout(layoutMasonry, 750);
            setTimeout(layoutMasonry, 1500);
            setTimeout(layoutMasonry, 3000);
        }

        images.forEach((img, index) => {
            const markLoaded = () => {
                img.classList.add("loaded");
                relayoutSeveralTimes();
            };

            img.addEventListener("load", markLoaded);
            img.addEventListener("error", relayoutSeveralTimes);

            if (img.complete && img.naturalWidth > 0) {
                markLoaded();
            }

            img.addEventListener("click", () => {
                currentIndex = index;
                lightboxImg.src = img.src;
                lightbox.classList.add("active");
                document.body.style.overflow = "hidden";
            });
        });

        window.addEventListener("load", relayoutSeveralTimes);
        window.addEventListener("resize", relayoutSeveralTimes);

        function closeLightbox() {
            lightbox.classList.remove("active");
            document.body.style.overflow = "";
        }

        function nextImage() {
            currentIndex = (currentIndex + 1) % images.length;
            lightboxImg.src = images[currentIndex].src;
        }

        function prevImage() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            lightboxImg.src = images[currentIndex].src;
        }

        document.addEventListener("keydown", function(event) {
            if (!lightbox.classList.contains("active")) return;

            if (event.key === "Escape") closeLightbox();
            if (event.key === "ArrowRight") nextImage();
            if (event.key === "ArrowLeft") prevImage();
        });

        lightbox.addEventListener("touchstart", function(event) {
            touchStartX = event.changedTouches[0].screenX;
        });

        lightbox.addEventListener("touchend", function(event) {
            touchEndX = event.changedTouches[0].screenX;

            const diff = touchStartX - touchEndX;

            if (Math.abs(diff) > 50) {
                if (diff > 0) {
                    nextImage();
                } else {
                    prevImage();
                }
            }
        });

        lightbox.addEventListener("click", function(event) {
            if (event.target === lightbox && window.innerWidth > 700) {
                closeLightbox();
            }
        });
    </script>
</body>
</html>
